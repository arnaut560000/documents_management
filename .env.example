# Copy this file to ".env" before pilot deployment.
# Use a unique SECRET_KEY before exposing the app on your office LAN.

SECRET_KEY=replace-with-a-long-random-secret-key
DATABASE_PATH=instance/neeco_dms.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png
SQLITE_TIMEOUT=10
SQLITE_BUSY_TIMEOUT_MS=10000

# Change these defaults before first office deployment if needed.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Optional Flask local run settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
